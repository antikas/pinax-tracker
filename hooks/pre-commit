#!/usr/bin/env python3
"""
Pinax pre-commit drift lint (ADR-002).

This hook is shipped in hooks/pre-commit and installed into .git/hooks/
by 'pinax init'.  It rejects any commit that would leave the projection
out of sync with the event log.

How to install manually:
    cp hooks/pre-commit .git/hooks/pre-commit
    chmod +x .git/hooks/pre-commit   # (POSIX only)
"""

import importlib.util
import os
import shutil
import subprocess
import sys

# Git may invoke a Python interpreter that cannot import Pinax.  A hook
# generated by `pinax init` records the interpreter used by that command and
# uses it as a final verification candidate.  The standalone template used
# for manual installation has no recorded interpreter, so this fallback is
# disabled until installation supplies one.
_INSTALL_TIME_PYTHON: str | None = None


def _pinax_verify_command() -> list[str] | None:
    exe = shutil.which("pinax")
    if exe:
        return [exe, "verify"]
    if importlib.util.find_spec("pinax") is not None:
        return [sys.executable, "-m", "pinax", "verify"]
    if _INSTALL_TIME_PYTHON and os.path.isfile(_INSTALL_TIME_PYTHON):
        # Re-verify pinax is actually importable under the baked-in
        # interpreter before trusting it — the path can go stale (venv
        # moved/recreated) between 'pinax init' and this commit.
        check = subprocess.run(
            [_INSTALL_TIME_PYTHON, "-c", "import pinax"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if check.returncode == 0:
            return [_INSTALL_TIME_PYTHON, "-m", "pinax", "verify"]
    return None


def main() -> None:
    root = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True
    )
    if root.returncode != 0:
        sys.exit(0)
    repo_root = root.stdout.strip()

    # Only run if .ergon/log/ exists (Pinax-managed repo).
    if not os.path.isdir(os.path.join(repo_root, ".ergon", "log")):
        sys.exit(0)

    command = _pinax_verify_command()
    if command is None:
        print(
            "pinax: WARNING - pre-commit hook could not find pinax; skipping verify.",
            file=sys.stderr,
        )
        sys.exit(0)

    result = subprocess.run(command, cwd=repo_root)
    sys.exit(result.returncode)


if __name__ == "__main__":
    main()
