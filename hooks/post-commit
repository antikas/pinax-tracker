#!/usr/bin/env python3
"""Regenerate a committed portfolio view after an ordinary Git commit."""

import os
import subprocess
import sys


_MARKER = "pinax: regenerate PORTFOLIO.md"


def _repo_root() -> str | None:
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True
    )
    return result.stdout.strip() if result.returncode == 0 else None


def main() -> None:
    repo_root = _repo_root()
    if not repo_root or not os.path.isdir(os.path.join(repo_root, ".ergon", "log")):
        return
    subject = subprocess.run(
        ["git", "log", "-1", "--format=%s"], cwd=repo_root, capture_output=True, text=True
    ).stdout.strip()
    if subject.startswith(_MARKER):
        return
    if subprocess.run([sys.executable, "-m", "pinax", "overview", "--markdown"], cwd=repo_root).returncode:
        return
    if subprocess.run(["git", "diff", "--quiet", "--", "PORTFOLIO.md"], cwd=repo_root).returncode:
        subprocess.run(["git", "add", "PORTFOLIO.md"], cwd=repo_root, check=False)
        subprocess.run(["git", "commit", "-m", _MARKER], cwd=repo_root, check=False)


if __name__ == "__main__":
    main()
